            {
              "id": "SAST-005",
              "name": "Rendu HTML brut non sécurisé (dangerouslySetInnerHTML / innerHTML)",
              "shortDescription": {
                "text": "Code Non Sécurisé (SAST)"
              },
              "help": {
                "text": "Assurez-vous de neutraliser/échapper le contenu utilisateur avant de l'insérer directement dans le DOM."
              }
            },
            {
              "id": "SAST-001",
              "name": "Concaténation SQL potentiellement risquée",
              "shortDescription": {
                "text": "Code Non Sécurisé (SAST)"
              },
              "help": {
                "text": "Utilisez systématiquement des requêtes préparées avec paramètres liés pour éviter les injections SQL."
              }
            },
            {
              "id": "SAST-002",
              "name": "Exécution dynamique de code (eval/exec)",
              "shortDescription": {
                "text": "Code Non Sécurisé (SAST)"
              },
              "help": {
                "text": "Évitez l'utilisation de eval() ou exec(). Privilégiez des structures de données dynamiques sécurisées."
              }
            },
            {
              "id": "SAST-004",
              "name": "Désactivation de la vérification TLS/SSL",
              "shortDescription": {
                "text": "Code Non Sécurisé (SAST)"
              },
              "help": {
                "text": "Conservez la vérification des certificats TLS pour empêcher les attaques de type Man-in-the-Middle (MitM)."
              }
            },
            {
              "id": "DEVSEC-036",
              "name": "Package Python : httpx",
              "shortDescription": {
                "text": "Version de Dépendance Non Fixée"
              },
              "help": {
                "text": "Verrouillez les versions de vos dépendances avec '==' (ex: requests==2.31.0) pour garantir la reproductibilité et éviter les régressions de sécurité."
              }
            },
